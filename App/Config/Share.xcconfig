#include "Base.xcconfig"

PRODUCT_NAME = AkouCompanionShare
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_BASE).share
INFOPLIST_FILE = ShareExtension/Info.plist
